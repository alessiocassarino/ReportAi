# ============================================================
#  TEMPLATE – copia questo file in ".env" e inserisci i valori.
#  Non inserire mai chiavi reali in questo file.
# ============================================================

# Chiave API Anthropic (Claude)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Chiave API Tavily (ricerca web)
# https://tavily.com/
TAVILY_API_KEY=tvly-dev-...

# JWT Secret (minimo 32 caratteri)
JWT_SECRET=genera-un-valore-sicuro-casuale-qui

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5400/vector_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=progetto-ai-494215
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_PATH=classpath:config/progetto-ai-494215-1a94e8abc771.json

# Ollama
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434