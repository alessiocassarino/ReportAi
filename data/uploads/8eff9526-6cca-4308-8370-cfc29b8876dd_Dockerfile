FROM postgres:16

# Installa le dipendenze necessarie per compilare pg_vector
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    postgresql-server-dev-16 \
    && rm -rf /var/lib/apt/lists/*

# Clona e compila pg_vector
RUN git clone --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector && \
    cd /tmp/pgvector && \
    make && \
    make install && \
    rm -rf /tmp/pgvector

# Pulisci la cache di apt per ridurre la dimensione dell'immagine
RUN apt-get remove -y build-essential git && apt-get autoremove -y